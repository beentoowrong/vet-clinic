// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  OWNER
}

enum Gender {
  MALE 
  FEMALE
}

enum ServiceType {
  IN_CLINIC
  HOME_VISIT
  TELECONSULTATION
}

enum AppointmentStatus {
  WAITING_FOR_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  EXPIRED
  CANCELLED
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String 
  phoneNumber String? @map("phone_number")
  role Role @default(OWNER)
  token String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi 1-to-1 Opsional ke profil spesifik
  petOwnerProfile PetOwner?
  doctorProfile Doctor?

  @@map("users")
}

model PetOwner {
  id Int @id @default(autoincrement())
  userId Int @unique @map("user_id")
  address String? @db.Text
  emergencyContact String? @map("emergency_contact")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relasi balik ke User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // relasi 1-to-N: Satu Owner punya banyak Pets
  pets Pet[]
  appointments Appointment[]

  @@map("pet_owners")
}

model Doctor {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  sipNumber      String   @unique @map("sip_number")
  specialization String
  practiceDays   String   @map("practice_days") // misal: "Senin - Jumat"
  startTime      String   @map("start_time")    // misal: "08:00"
  endTime        String   @map("end_time")      // misal: "16:00"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relasi balik ke User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  medicalRecords MedicalRecord[]

  @@map("doctors")
}

model Pet {
  id           Int      @id @default(autoincrement())
  ownerId      Int      @map("owner_id")
  name         String
  species      String   // misal: "Dog", "Cat"
  breed        String?  // misal: "Siberian Husky"
  gender       Gender
  age          Int      // Dalam tahun/bulan
  weightKg     Float?   @map("weight_kg")
  specialMarks String?  @map("special_marks") @db.Text
  isSterilized Boolean  @default(false) @map("is_sterilized")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relasi balik ke PetOwner
  owner PetOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@map("pets")
}

model Appointment {
  id Int @id @default(autoincrement())
  appointmentCode String @unique @map("appointment_code")
  petId Int @map("pet_id")
  ownerId Int @map("owner_id")
  doctorId Int @map("doctor_id")
  appointmentDate DateTime @map("appointment_date") @db.Date
  appointmentTime String @map("appointment_time") // format "14:00"
  serviceType ServiceType @default(IN_CLINIC) @map("service_type")
  status AppointmentStatus @default(CONFIRMED) @map("appointment_status")
  complaint String? @db.Text
  homeVisitAddress String? @map("home_visit_address") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // relasi 
  pet           Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner         PetOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  invoice Invoice?
  medicalRecord MedicalRecord?

  @@map("appointments")
}

model Invoice {
  id Int @id @default(autoincrement())
  invoiceNumber String @unique @map("invoice_number")
  appointmentId Int @unique @map("appointment_id")
  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)
  status InvoiceStatus @default(UNPAID)
  paymentDueDate DateTime @map("payment_due_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model MedicalRecord {
  id Int @id @default(autoincrement())
  recordCode String @unique @map("record_code")
  appointmentId Int @unique @map("appointment_id")
  petId Int @map("pet_id")
  doctorId Int @map("doctor_id")
  weightKg Float @map("weight_kg")
  temperatureCelcius Float @map("temperature_celcius")
  symptoms String @db.Text
  diagnosis String @db.Text
  treatment String @db.Text
  notes String? @db.Text
  followUpDate DateTime? @map("follow_up_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]

}

model Prescription {
  id Int @id @default(autoincrement())
  medicalRecordId Int @map("medical_record_id")
  medicineName String @map("medicine_name")
  dosage String
  frequency String
  duration String
  notes String?
  createdAt    DateTime @default(now()) @map("created_at")

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
}